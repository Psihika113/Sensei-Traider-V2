{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "format": "%(message)s"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "json",
      "stream": "ext://sys.stdout"
    },
    "error_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "formatter": "json",
      "filename": "logs/error.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "encoding": "utf-8"
    }
  },
  "loggers": {
    "sensei": {
      "level": "INFO",
      "handlers": ["stdout", "error_file"],
      "propagate": false
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": ["stdout", "error_file"]
  }
}
